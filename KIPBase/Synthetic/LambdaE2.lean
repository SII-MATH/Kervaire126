import KIPBase.StableHomotopy.Adams

/-!
# The E₂ page of a finite λ-quotient

This file carries out the algebraic first step in the λ-Bockstein comparison.
Starting with an Adams E₂ component `A`, its free graded λ-module has one copy
of `A` in every weight `w ≤ t`.  The cokernel of multiplication by `λ^n`
retains exactly the weights `0 ≤ t-w < n`.

No spectral-sequence comparison is assumed here.  In particular, the result
below is the calculation to which the E₂ page of the λ-cofiber must be
identified by Adams exactness and naturality.
-/

namespace KIPBase.Synthetic

open CategoryTheory CategoryTheory.Limits KIPBase.StableHomotopy

universe u v

/-- The underlying group of a zero object in `AddCommGrpCat` is a
subsingleton.  This small bridge is useful when transporting zero objects
through additive equivalences whose two sides live in different universes. -/
theorem addCommGrpCatSubsingletonOfIsZero (A : AddCommGrpCat.{v})
    (h : IsZero A) : Subsingleton A where
  allEq a b := by
    have hi : (𝟙 A : A ⟶ A) = 0 := h.eq_of_src _ _
    calc
      a = (𝟙 A : A ⟶ A) a := rfl
      _ = (0 : A ⟶ A) a := congrArg (fun f : A ⟶ A => f a) hi
      _ = 0 := rfl
      _ = (0 : A ⟶ A) b := rfl
      _ = (𝟙 A : A ⟶ A) b := congrArg (fun f : A ⟶ A => f b) hi.symm
      _ = b := rfl

/-- Forget a categorical isomorphism of abelian groups to an additive
equivalence of its underlying groups. -/
noncomputable def addEquivOfAddCommGrpCatIso {A B : AddCommGrpCat.{v}}
    (e : A ≅ B) : A ≃+ B where
  toFun := e.hom.hom
  invFun := e.inv.hom
  left_inv a := by
    have h := congrArg (fun f : A ⟶ A => f.hom a) e.hom_inv_id
    exact h
  right_inv b := by
    have h := congrArg (fun f : B ⟶ B => f.hom b) e.inv_hom_id
    exact h
  map_add' a b := e.hom.hom.map_add a b

namespace FreeLambdaE2

/-- The weight-`w` component of the free graded λ-module generated by `A` in
weight `t`. Multiplication by λ lowers weight, so copies of `A` occur for
`w ≤ t`. -/
noncomputable def component (A : AddCommGrpCat.{v}) (t w : ℤ) :
    AddCommGrpCat.{v} :=
  if w ≤ t then A else ⊥_ AddCommGrpCat

/-- Multiplication by `λ^n` on the free graded λ-module, from weight `w+n`
to weight `w`. It is the identity between two copies of the generator and
zero when the source component vanishes. -/
noncomputable def lambdaPow (A : AddCommGrpCat.{v}) (t w : ℤ) (n : ℕ) :
    component A t (w + n) ⟶ component A t w := by
  by_cases hs : w + (n : ℤ) ≤ t
  · have ht : w ≤ t := by omega
    exact eqToHom (by simp [component, hs]) ≫
      𝟙 A ≫ eqToHom (by simp [component, ht])
  · exact 0

/-- Inside the free λ-tower, multiplication by `λ^n` is an isomorphism
between two copies of the generator. -/
noncomputable def lambdaPowIso (A : AddCommGrpCat.{v}) (t w : ℤ) (n : ℕ)
    (h : w + (n : ℤ) ≤ t) :
    component A t (w + n) ≅ component A t w := by
  have ht : w ≤ t := by omega
  haveI : IsIso (lambdaPow A t w n) := by
    dsimp only [lambdaPow]
    rw [dif_pos h]
    infer_instance
  exact asIso (lambdaPow A t w n)

/-- Consequently, multiplication by `λ^n` is injective in the free range. -/
theorem lambdaPow_injective (A : AddCommGrpCat.{v}) (t w : ℤ) (n : ℕ)
    (h : w + (n : ℤ) ≤ t) :
    Function.Injective (lambdaPow A t w n).hom := by
  let e := lambdaPowIso A t w n h
  intro x y hxy
  have h' := congrArg (fun z => e.inv.hom z) hxy
  simpa [e, lambdaPowIso] using h'

end FreeLambdaE2

namespace TruncatedLambdaE2

/-- The weight-`w` component after quotienting the free λ-module by `λ^n`.
It is a copy of the generator precisely in the strip `0 ≤ t-w < n`. -/
noncomputable def component (A : AddCommGrpCat.{v})
    (t w : ℤ) (n : ℕ) : AddCommGrpCat.{v} :=
  if w ≤ t ∧ t < w + n then A else ⊥_ AddCommGrpCat

theorem component_eq_generator_iff (A : AddCommGrpCat.{v})
    (t w : ℤ) (n : ℕ) (h : 0 ≤ t - w ∧ t - w < n) :
    component A t w n = A := by
  rw [component, if_pos]
  constructor <;> omega

theorem component_eq_zero_of_outside (A : AddCommGrpCat.{v})
    (t w : ℤ) (n : ℕ) (h : t - w < 0 ∨ (n : ℤ) ≤ t - w) :
    component A t w n = ⊥_ AddCommGrpCat := by
  rw [component, if_neg]
  omega

end TruncatedLambdaE2

/-- Quotienting a free graded λ-module by `λ^n` gives the truncated strip
`0 ≤ t-w < n`, component by component. -/
noncomputable def freeLambdaE2QuotientIso (A : AddCommGrpCat.{v})
    (t w : ℤ) (n : ℕ) :
    cokernel (FreeLambdaE2.lambdaPow A t w n) ≅
      TruncatedLambdaE2.component A t w n := by
  by_cases ht : w ≤ t
  · by_cases hs : w + (n : ℤ) ≤ t
    · have htr : TruncatedLambdaE2.component A t w n =
          ⊥_ AddCommGrpCat := by
        rw [TruncatedLambdaE2.component, if_neg]
        exact fun h => (not_lt_of_ge hs) h.2
      rw [htr]
      haveI : IsIso (FreeLambdaE2.lambdaPow A t w n) := by
        dsimp only [FreeLambdaE2.lambdaPow]
        rw [dif_pos hs]
        infer_instance
      exact IsZero.iso
        (isZero_cokernel_of_epi (FreeLambdaE2.lambdaPow A t w n))
        (IsInitial.isZero initialIsInitial)
    · have hm : FreeLambdaE2.lambdaPow A t w n = 0 := by
        simp [FreeLambdaE2.lambdaPow, hs]
      have htr : TruncatedLambdaE2.component A t w n = A := by
        simp [TruncatedLambdaE2.component, ht]
        omega
      have htarget : FreeLambdaE2.component A t w = A := by
        simp [FreeLambdaE2.component, ht]
      exact cokernelIsoOfEq hm ≪≫ cokernelZeroIsoTarget ≪≫
        eqToIso htarget ≪≫ eqToIso htr.symm
  · have htr : TruncatedLambdaE2.component A t w n =
        ⊥_ AddCommGrpCat := by
      simp [TruncatedLambdaE2.component, ht]
    rw [htr]
    have hz : IsZero (FreeLambdaE2.component A t w) := by
      rw [FreeLambdaE2.component, if_neg ht]
      exact IsInitial.isZero initialIsInitial
    exact IsZero.iso
      (hz.of_epi (cokernel.π (FreeLambdaE2.lambdaPow A t w n)))
      (IsInitial.isZero initialIsInitial)

/-! ## Specialization to the E₂ page of νX -/

variable (𝒮 : Type u) [StableHomotopyCategory.{u, v} 𝒮]

/-- The free lambda model is formulated in abelian groups.  Classical Adams
E2 is now integer-linear, so this is its underlying additive group. -/
noncomputable def adamsE2Underlying (X : 𝒮) (s t : ℤ) : AddCommGrpCat.{v} :=
  (forget₂ (ModuleCat.{v, v} IntModuleRing.{v}) AddCommGrpCat.{v}).obj
    ((AdamsSS 𝒮 X).Page 2 (s, t))

/-- The free λ-module model for the `(s,t,w)` component of the synthetic
Adams E₂ page of `νX`. -/
noncomputable def nuAdamsE2FreeComponent (X : 𝒮) (s t w : ℤ) :
    AddCommGrpCat.{v} :=
  FreeLambdaE2.component (adamsE2Underlying 𝒮 X s t) t w

/-- The resulting model for the E₂ page of `νX/λ^n`. -/
noncomputable def nuModLambdaE2Component (X : 𝒮) (n : ℕ)
    (s t w : ℤ) : AddCommGrpCat.{v} :=
  TruncatedLambdaE2.component (adamsE2Underlying 𝒮 X s t) t w n

/-- The finite-quotient E₂ model is the cokernel of `λ^n` on the free
λ-module E₂ model of `νX`. -/
noncomputable def nuModLambdaE2QuotientIso (X : 𝒮) (n : ℕ)
    (s t w : ℤ) :
    cokernel (FreeLambdaE2.lambdaPow
      (adamsE2Underlying 𝒮 X s t) t w n) ≅
      nuModLambdaE2Component 𝒮 X n s t w :=
  freeLambdaE2QuotientIso _ t w n

/-- In every weight inside `0 ≤ t-w < n`, the truncated E₂ model is one
copy of the classical Adams E₂ group. -/
noncomputable def nuModLambdaE2InStripIso (X : 𝒮) (n : ℕ)
    (s t w : ℤ) (h : 0 ≤ t - w ∧ t - w < n) :
    nuModLambdaE2Component 𝒮 X n s t w ≅
      adamsE2Underlying 𝒮 X s t :=
  eqToIso (TruncatedLambdaE2.component_eq_generator_iff
    (adamsE2Underlying 𝒮 X s t) t w n h)

/-- Equivalently, the cokernel of `λ^n` on the free E₂ model is the
classical Adams E₂ group in every weight of the surviving strip. -/
noncomputable def nuModLambdaE2QuotientInStripIso (X : 𝒮) (n : ℕ)
    (s t w : ℤ) (h : 0 ≤ t - w ∧ t - w < n) :
    cokernel (FreeLambdaE2.lambdaPow
      (adamsE2Underlying 𝒮 X s t) t w n) ≅
      adamsE2Underlying 𝒮 X s t :=
  nuModLambdaE2QuotientIso 𝒮 X n s t w ≪≫
    nuModLambdaE2InStripIso 𝒮 X n s t w h

/-- For the first λ-quotient, the only surviving weight is the generator
weight `w=t`, where the component is the classical Adams E₂ component. -/
noncomputable def nuModLambdaE2OneDiagonalIso (X : 𝒮) (s t w : ℤ)
    (h : w = t) :
    nuModLambdaE2Component 𝒮 X 1 s t w ≅
      adamsE2Underlying 𝒮 X s t :=
  nuModLambdaE2InStripIso 𝒮 X 1 s t w (by omega)

/-- Away from `w=t`, the first λ-quotient E₂ model vanishes. -/
theorem nuModLambdaE2OneIsZero (X : 𝒮) (s t w : ℤ) (h : w ≠ t) :
    IsZero (nuModLambdaE2Component 𝒮 X 1 s t w) := by
  rw [nuModLambdaE2Component,
    TruncatedLambdaE2.component_eq_zero_of_outside]
  · exact IsInitial.isZero initialIsInitial
  · omega

/-- Direct form of the first-quotient calculation on the surviving
diagonal: the cokernel of λ on the free E₂ page is the classical Adams
E₂ component. -/
noncomputable def nuModLambdaE2OneQuotientDiagonalIso (X : 𝒮)
    (s t w : ℤ) (h : w = t) :
    cokernel (FreeLambdaE2.lambdaPow
      (adamsE2Underlying 𝒮 X s t) t w 1) ≅
      adamsE2Underlying 𝒮 X s t :=
  nuModLambdaE2QuotientInStripIso 𝒮 X 1 s t w (by omega)

/-- Direct form away from the diagonal: the cokernel of λ on the free E₂
page vanishes. -/
theorem nuModLambdaE2OneQuotientIsZero (X : 𝒮)
    (s t w : ℤ) (h : w ≠ t) :
    IsZero (cokernel (FreeLambdaE2.lambdaPow
      (adamsE2Underlying 𝒮 X s t) t w 1)) :=
  (nuModLambdaE2OneIsZero 𝒮 X s t w h).of_iso
    (nuModLambdaE2QuotientIso 𝒮 X 1 s t w)

end KIPBase.Synthetic
