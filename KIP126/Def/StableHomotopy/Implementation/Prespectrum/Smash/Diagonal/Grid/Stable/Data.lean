module

public import KIP126.Def.StableHomotopy.Implementation.Prespectrum.Smash.Diagonal.Grid.Class.Proofs

@[expose] public section

namespace KIP126.StableHomotopy.Implementation.Prespectrum

/-- Relations generated by the two actual grid stabilization directions. -/
inductive DiagonalGridRelation (X Y : Prespectrum.{0}) (d : ℤ) :
    DiagonalGridClass X Y d → DiagonalGridClass X Y d → Prop
  | horizontal (a) : DiagonalGridRelation X Y d a a.horizontal
  | vertical (a) : DiagonalGridRelation X Y d a a.vertical

/-- The quotient of actual two-index homotopy classes by their two
displayed stabilization relations. -/
def DiagonalGridStable (X Y : Prespectrum.{0}) (d : ℤ) :=
  Quot (DiagonalGridRelation X Y d)

/-- Actual grid homotopy classes with equal left and right stages. -/
def DiagonalGridDiagonalClass (X Y : Prespectrum.{0}) (d : ℤ) :=
  {a : DiagonalGridClass X Y d // a.left = a.right}

/-- One diagonal step consists of the two actual grid bonds. -/
noncomputable def DiagonalGridDiagonalClass.next {X Y : Prespectrum.{0}} {d : ℤ}
    (a : DiagonalGridDiagonalClass X Y d) : DiagonalGridDiagonalClass X Y d :=
  ⟨a.val.horizontal.vertical,congrArg (· + 1) a.property⟩

/-- The only stabilization relation on the equal-stage grid is its
displayed two-bond transition. -/
inductive DiagonalGridDiagonalRelation (X Y : Prespectrum.{0}) (d : ℤ) :
    DiagonalGridDiagonalClass X Y d → DiagonalGridDiagonalClass X Y d → Prop
  | step (a) : DiagonalGridDiagonalRelation X Y d a a.next

/-- The actual diagonal grid quotient, prior to identifying its
retained equal-stage spaces with the original recursive diagonal model. -/
def DiagonalGridDiagonalStable (X Y : Prespectrum.{0}) (d : ℤ) :=
  Quot (DiagonalGridDiagonalRelation X Y d)

/-- The explicit sum-stage normalization, with its proved equal indices. -/
noncomputable def DiagonalGridClass.toDiagonal {X Y : Prespectrum.{0}} {d : ℤ}
    (a : DiagonalGridClass X Y d) : DiagonalGridDiagonalClass X Y d :=
  ⟨a.normalize,a.normalize_left.trans a.normalize_right.symm⟩

end KIP126.StableHomotopy.Implementation.Prespectrum
