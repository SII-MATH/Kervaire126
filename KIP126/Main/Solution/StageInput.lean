  have raw_connecting_zero_normalization
      (coh : BiShiftCoherence Syn) (nf ng nh : ℕ)
      (hf : nf=1) (hg : ng=0) (hh : nh=0) (he : (nf:ℤ)+(ng:ℤ)+(nh:ℤ)=1)
