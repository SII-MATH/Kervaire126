module

public import KIP126.LinProgram.Model.BasisTable.Data
public import Batteries.Data.String.Lemmas

-- The CSV proofs explicitly unfold these string/list implementations.
import all Init.Data.List.SplitOn.Basic
import all Init.Data.String.Legacy
import all Init.Data.String.Search
import all Init.Data.String.Slice

@[expose] public section
namespace KIP126.Main.Solution.Route.Section7
open KIP126.LinE2
set_option maxRecDepth 100000
set_option maxHeartbeats 12000000
private theorem full_basis_low_joint :
    ∀ r ∈ basisRows,
      (r.s=0 → r.t=0 → r.monomial="") ∧
      (r.s=1 → r.t=2 → r.monomial="1,1") ∧
      (r.s=2 → r.t=3 → False) := by
  let charsIsNat (s : List Char) : Bool := Id.run do
    let mut lastWasDigit := false
    for c in s do
      if c = '_' then
        if !lastWasDigit then return false
        lastWasDigit := false
      else if c.isDigit then lastWasDigit := true
      else return false
    return lastWasDigit
  let charsNat (s : List Char) : Option Nat :=
    if charsIsNat s then
      some (s.foldl (fun n c => if c = '_' then n else n * 10 + (c.toNat - '0'.toNat)) 0)
    else none
  have charsNat_correct (s : String) : s.toNat? = charsNat s.toList := by
    simp only [String.toNat?, String.Slice.toNat?, String.Slice.isNat,
      String.Slice.forIn_eq_forIn_toList, String.Slice.foldl_eq_foldl_toList,
      String.copy_toSlice, charsNat, charsIsNat]
  have splitOnAux_char (s : String) (c : Char) (b i : String.Pos.Raw)
      (acc : List String) :
      s.splitOnAux (String.singleton c) b i 0 acc = s.splitAux (· == c) b i acc := by
    have hg : String.Pos.Raw.get (String.singleton c) 0 = c := by
      simp only [String.Pos.Raw.get, String.toList_singleton, String.Pos.Raw.utf8GetAux,
        ↓reduceIte]
    have hn : String.Pos.Raw.next (String.singleton c) 0 = ⟨c.utf8Size⟩ := by
      simp [String.Pos.Raw.next, hg, String.Pos.Raw.ext_iff]
    have he : String.Pos.Raw.atEnd (String.singleton c) ⟨c.utf8Size⟩ = true := by
      simp [String.Pos.Raw.atEnd]
    fun_induction String.splitAux s (· == c) b i acc with
    | case1 b i acc h => rw [String.splitOnAux, if_pos h]
    | case2 b i acc h _ h' i' ih =>
      have hi : String.Pos.Raw.get s i = c := by simpa using h'
      have hu : (String.Pos.Raw.next s i).unoffsetBy ⟨c.utf8Size⟩ = i := by
        simp [String.Pos.Raw.next, hi, String.Pos.Raw.unoffsetBy]
      rw [String.splitOnAux, if_neg h, hg, if_pos h', hn, if_pos he, hu]
      exact ih
    | case3 b i acc h _ h' ih =>
      have hu : i.unoffsetBy 0 = i := by cases i; simp [String.Pos.Raw.unoffsetBy]
      rw [String.splitOnAux, if_neg h, hg, if_neg h', hu]
      exact ih
  have splitOn_char (s : String) (c : Char) :
      s.splitOn (String.singleton c) = (s.toList.splitOn c).map String.ofList := by
    have hc : (String.singleton c == "") = false := by simp
    rw [String.splitOn, hc, if_neg Bool.false_ne_true, splitOnAux_char]
    change String.splitToList s (· == c) = _
    rw [String.splitToList_of_valid, List.splitOn_eq_splitOnP]

  let CharRow := Nat × Nat × Nat × List Char
  let liftRow (x : CharRow) : BasisRow := ⟨x.1,x.2.1,x.2.2.1,String.ofList x.2.2.2⟩
  let charsDecode (line : List Char) : Except String CharRow := do
    let [s,t,index,code] := line.splitOn '|'
      | throw "malformed basis row"
    let some s := charsNat s | throw "invalid basis filtration"
    let some t := charsNat t | throw "invalid basis internal degree"
    let some index := charsNat index | throw "invalid basis index"
    return (s,t,index,code)
  have charsDecode_correct (s : String) :
      decodeBasisRow s = (charsDecode s.toList).map liftRow := by
    unfold decodeBasisRow charsDecode
    rw [show "|" = String.singleton '|' from rfl, splitOn_char]
    generalize s.toList.splitOn '|' = l
    rcases l with _ | ⟨a,l⟩ <;> simp only [List.map_nil, List.map_cons]
    · rfl
    rcases l with _ | ⟨b,l⟩ <;> simp only [List.map_nil, List.map_cons]
    · rfl
    rcases l with _ | ⟨c,l⟩ <;> simp only [List.map_nil, List.map_cons]
    · rfl
    rcases l with _ | ⟨d,l⟩ <;> simp only [List.map_nil, List.map_cons]
    · rfl
    rcases l with _ | ⟨e,l⟩ <;> simp only [List.map_nil, List.map_cons]
    · simp only [charsNat_correct,String.toList_ofList]
      cases charsNat a <;> cases charsNat b <;> cases charsNat c <;> rfl
    · rfl
  let charCheck (l : List Char) : Bool :=
    match charsDecode l with
    | .error _ => true
    | .ok (s,t,_,c) =>
        (!(s == 0 && t == 0) || c == []) &&
        (!(s == 1 && t == 2) || c == ['1',',','1']) &&
        !(s == 2 && t == 3)
  let RowGood (r : BasisRow) : Prop :=
    (r.s=0 → r.t=0 → r.monomial="") ∧
    (r.s=1 → r.t=2 → r.monomial="1,1") ∧
    (r.s=2 → r.t=3 → False)
  have charCheck_sound (s : String) (r : BasisRow)
      (hc : charCheck s.toList = true) (he : decodeBasisRow s = .ok r) : RowGood r := by
    rw [charsDecode_correct] at he
    cases hd : charsDecode s.toList with
    | error e =>
      rw [hd] at he
      cases he
    | ok x =>
      simp only [hd,Except.map] at he
      cases he
      rcases x with ⟨a,b,i,c⟩
      simp only [charCheck,hd] at hc
      dsimp [RowGood,liftRow]
      refine ⟨?_,?_,?_⟩
      · intro ha hb
        subst a; subst b
        have hchars : c = [] := by simpa using hc
        simpa using congrArg String.ofList hchars
      · intro ha hb
        subst a; subst b
        have hchars : c = ['1',',','1'] := by simpa using hc
        simpa using congrArg String.ofList hchars
      · intro ha hb
        subst a; subst b
        simpa using hc
  have mapM_good (ls : List String)
      (hls : ∀ s ∈ ls, ∀ r, decodeBasisRow s = .ok r → RowGood r)
      (rs : List BasisRow) (hr : ls.mapM decodeBasisRow = .ok rs) :
      ∀ r ∈ rs, RowGood r := by
    induction ls generalizing rs with
    | nil =>
      simp only [List.mapM_nil] at hr
      cases hr
      simp
    | cons a l ih =>
      cases ha : decodeBasisRow a with
      | error e =>
        rw [List.mapM_cons,ha] at hr
        cases hr
      | ok b =>
        cases hl : l.mapM decodeBasisRow with
        | error e =>
          rw [List.mapM_cons,ha,hl] at hr
          cases hr
        | ok bs =>
          rw [List.mapM_cons,ha,hl] at hr
          cases hr
          intro r hmem
          rcases List.mem_cons.mp hmem with h | h
          · subst r
            exact hls a (by simp) b ha
          · exact ih (fun s hs => hls s (by simp [hs])) bs hl r h
  have all_rows_good
      (hc : ∀ chunk ∈ RawData.basisChunks.toList,
        (chunk.toList.splitOn '\n').all charCheck = true) :
      ∀ r ∈ basisRows, RowGood r := by
    unfold basisRows
    cases he : parseBasisRows with
    | error e =>
      change ∀ r ∈ ([] : List BasisRow), RowGood r
      simp
    | ok rs =>
      simp only [Except.toOption,Option.getD]
      apply mapM_good _ ?_ rs he
      intro s hs r hr
      rcases List.mem_flatMap.mp hs with ⟨chunk,hchunk,hs⟩
      rw [show "\n"=String.singleton '\n' from rfl, splitOn_char] at hs
      rcases List.mem_map.mp hs with ⟨cs,hcs,rfl⟩
      apply charCheck_sound _ _ ?_ hr
      simpa only [String.toList_ofList] using (List.all_eq_true.mp (hc chunk hchunk) cs hcs)
  let rows0 : List (List Char) := [['0','|','0','|','0','|'],['1','|','1','|','0','|','0',',','1'],['2','|','2','|','0','|','0',',','2'],['1','|','2','|','0','|','1',',','1'],['3','|','3','|','0','|','0',',','3'],['4','|','4','|','0','|','0',',','4'],['2','|','4','|','0','|','1',',','2'],['1','|','4','|','0','|','2',',','1'],['5','|','5','|','0','|','0',',','5'],['2','|','5','|','0','|','0',',','1',',','2',',','1'],['6','|','6','|','0','|','0',',','6'],['3','|','6','|','0','|','0',',','2',',','2',',','1'],['7','|','7','|','0','|','0',',','7'],['8','|','8','|','0','|','0',',','8'],['2','|','8','|','0','|','2',',','2'],['1','|','8','|','0','|','3',',','1'],['9','|','9','|','0','|','0',',','9'],['2','|','9','|','0','|','0',',','1',',','3',',','1'],['1','0','|','1','0','|','0','|','0',',','1','0'],['3','|','1','0','|','0','|','0',',','2',',','3',',','1'],['2','|','1','0','|','0','|','1',',','1',',','3',',','1'],['1','1','|','1','1','|','0','|','0',',','1','1'],['4','|','1','1','|','0','|','0',',','3',',','3',',','1'],['3','|','1','1','|','0','|','4',',','1'],['1','2','|','1','2','|','0','|','0',',','1','2'],['3','|','1','2','|','0','|','1',',','2',',','3',',','1'],['1','3','|','1','3','|','0','|','0',',','1','3'],['4','|','1','3','|','0','|','1',',','1',',','4',',','1'],['1','4','|','1','4','|','0','|','0',',','1','4'],['5','|','1','4','|','0','|','5',',','1'],['1','5','|','1','5','|','0','|','0',',','1','5'],['1','6','|','1','6','|','0','|','0',',','1','6'],['6','|','1','6','|','0','|','1',',','1',',','5',',','1'],['5','|','1','6','|','0','|','6',',','1'],['2','|','1','6','|','0','|','3',',','2'],['1','|','1','6','|','0','|','7',',','1'],['1','7','|','1','7','|','0','|','0',',','1','7'],['6','|','1','7','|','0','|','0',',','1',',','6',',','1'],['3','|','1','7','|','0','|','0',',','1',',','3',',','2'],['2','|','1','7','|','0','|','0',',','1',',','7',',','1'],['1','8','|','1','8','|','0','|','0',',','1','8'],['7','|','1','8','|','0','|','0',',','2',',','6',',','1'],['4',