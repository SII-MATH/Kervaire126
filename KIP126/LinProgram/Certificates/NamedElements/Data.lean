module

public import Mathlib.Data.List.Basic
public import KIP126.LinProgram.Tactic.LinCert

@[expose] public section


namespace NamedElementCertificates

/-- Sorted variable IDs, with repetitions representing powers. -/
abbrev Monomial := List Nat
abbrev Polynomial := List Monomial

def insertVariable (x : Nat) : Monomial → Monomial
  | [] => [x]
  | y :: ys => if x ≤ y then x :: y :: ys else y :: insertVariable x ys
def sortMonomial : Monomial → Monomial
  | [] => []
  | x :: xs => insertVariable x (sortMonomial xs)
def multiplyMonomial (a b : Monomial) : Monomial := sortMonomial (a ++ b)
def multiply (a b : Polynomial) : Polynomial :=
  a.flatMap fun x => b.map (multiplyMonomial x)
def coefficient (p : Polynomial) (m : Monomial) : Bool :=
  (p.filter (· == m)).length % 2 == 1

structure Term where
  relation : Nat
  multiplier : Polynomial
  deriving Lean.ToJson, Lean.FromJson, Lean.ToExpr

def combination (relations : List Polynomial) (terms : List Term) : Polynomial :=
  terms.flatMap fun t => multiply t.multiplier (relations[t.relation]?.getD [])

/-- Explicit membership in the polynomial ideal generated by the imported
relations: input+output is a finite sum of polynomial multiples of relations,
with equality of every F2 coefficient. This claim is relative to those
relations; it does not establish that they present Ext or are a Groebner basis. -/
def EqualModuloRelations (relations : List Polynomial) (input output : Polynomial) : Prop :=
  ∃ terms : List Term, (∀ t ∈ terms, t.relation < relations.length) ∧
    ∀ m, coefficient (input ++ output) m = coefficient (combination relations terms) m

def check (relations : List Polynomial) (input output : Polynomial) (terms : List Term) : Bool :=
  terms.all (fun t => t.relation < relations.length) &&
  ((input ++ output) ++ combination relations terms).all fun m =>
    coefficient (input ++ output) m == coefficient (combination relations terms) m

theorem coefficient_absent (p : Polynomial) (m : Monomial) (h : m ∉ p) : coefficient p m = false := by
  have hf : p.filter (· == m) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro x hx
    simp only [beq_iff_eq]
    intro he
    exact h (he ▸ hx)
  simp only [coefficient, hf]
  rfl

theorem check_sound (relations : List Polynomial) (input output : Polynomial) (terms : List Term)
    (h : check relations input output terms = true) : EqualModuloRelations relations input output := by
  simp only [check, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  refine ⟨terms, h.1, ?_⟩
  intro m
  by_cases hm : m ∈ (input ++ output) ++ combination relations terms
  · exact beq_iff_eq.mp (h.2 m hm)
  · simp only [List.mem_append, not_or] at hm
    rw [coefficient_absent _ _ (by simpa using hm.1), coefficient_absent _ _ hm.2]

instance (relations : List Polynomial) (input output : Polynomial) :
    LinProgramCertificates.CertificateVerifier (EqualModuloRelations relations input output) where
  Cert := List Term
  check := check relations input output
  sound := check_sound relations input output

structure Bundle where
  relations : List Polynomial
  input : Polynomial
  output : Polynomial
  terms : List Term
  deriving Lean.ToJson, Lean.FromJson, Lean.ToExpr

def parse (text : String) : Except String Bundle := do
  let b : Bundle ← Lean.fromJson? (← Lean.Json.parse text)
  if (Lean.toJson b).compress != text then throw "noncanonical or unknown/duplicate fields"
  return b

end NamedElementCertificates
