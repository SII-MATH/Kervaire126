import KIP126.LinProgram.Certificates.SquareDimension.Generators.Proofs
import Mathlib.Algebra.Order.Monoid.Prod

namespace KIP126.LinE2

open KIP126.Core.Algebra

local instance : NeZero RawData.generatorCount := ⟨by decide⟩

/-- The degree bound restricts every factor to the certified small list. -/
theorem squareDegree_support (m : Generator →₀ ℕ)
    (hm : monomialDegree m = (2, 128)) :
    m.support ⊆ ({0, 1, 2, 3, 7, 18, 69, 324} : Finset Generator) := by
  intro i hi
  have hmi : 1 ≤ m i := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi)
  have hle : (m i * (generatorDegree i).1, m i * (generatorDegree i).2) ≤
      monomialDegree m := by
    simpa [monomialDegree] using Finsupp.single_le_sum m
      (g := fun j a => (a * (generatorDegree j).1, a * (generatorDegree j).2))
      (by intro j a; exact ⟨Nat.zero_le _, Nat.zero_le _⟩) i
  rw [hm] at hle
  have hs : (generatorDegree i).1 ≤ 2 := by
    calc
      _ = 1 * (generatorDegree i).1 := (one_mul _).symm
      _ ≤ m i * (generatorDegree i).1 := Nat.mul_le_mul_right _ hmi
      _ ≤ 2 := hle.1
  have ht : (generatorDegree i).2 ≤ 128 := by
    calc
      _ = 1 * (generatorDegree i).2 := (one_mul _).symm
      _ ≤ m i * (generatorDegree i).2 := Nat.mul_le_mul_right _ hmi
      _ ≤ 128 := hle.2
  have h := (generatorDegree_low_filtration i).2 hs ht
  simpa [Fin.ext_iff, RawData.generatorCount] using h

/-- The only polynomial monomial in bidegree `(2,128)` is the square
of generator 69. This is stronger than a statement in the quotient. -/
theorem monomialDegree_square_unique (m : Generator →₀ ℕ)
    (hm : monomialDegree m = (2, 128)) :
    m = Finsupp.single h6Generator 2 := by
  have hsupp := squareDegree_support m hm
  have hdegree : monomialDegree m =
      (m 0 + m 1 + m 2 + m 3 + m 7 + m 18 + m 69 + m 324,
        m 0 + 2 * m 1 + 4 * m 2 + 8 * m 3 + 16 * m 7 +
          32 * m 18 + 64 * m 69 + 128 * m 324) := by
    unfold monomialDegree
    rw [m.sum_of_support_subset hsupp _ (by intros; simp)]
    simp [generatorDegree_eq_row, RawData.generatorRow, RawData.generatorChunkIndex,
      RawData.generatorChunk0, RawData.generatorChunk2, RawData.generatorChunk10,
      RawData.generatorCount, Nat.mul_comm, Nat.add_assoc]
  have hs := congrArg Prod.fst (hdegree.symm.trans hm)
  have ht := congrArg Prod.snd (hdegree.symm.trans hm)
  dsimp at hs ht
  have hvalues : m 0 = 0 ∧ m 1 = 0 ∧ m 2 = 0 ∧ m 3 = 0 ∧ m 7 = 0 ∧
      m 18 = 0 ∧ m 69 = 2 ∧ m 324 = 0 := by omega
  ext i
  by_cases hi : i ∈ m.support
  · have hi' := hsupp hi
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi'
    rcases hi' with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp_all [h6Generator, RawData.generatorCount]
    norm_num [Finsupp.single_apply, Fin.ext_iff, RawData.generatorCount]
    decide
  · have hzero := Finsupp.notMem_support_iff.mp hi
    have hi69 : i ≠ h6Generator := by
      intro he
      subst i
      change m 69 = 0 at hzero
      omega
    simp [hzero, Finsupp.single_eq_of_ne hi69]

/-- The actual homogeneous submodule is generated by the specified square;
no assertion about the archived additive basis is needed. -/
theorem homogeneousPart_square_eq_span : homogeneousPart 2 128 =
    Submodule.span F2 ({generator h6Generator ^ 2} : Set E2) := by
  unfold homogeneousPart
  apply congrArg (Submodule.span F2)
  ext x
  constructor
  · rintro ⟨m, hm, rfl⟩
    rw [monomialDegree_square_unique m hm]
    simp [← MvPolynomial.X_pow_eq_monomial, generator]
  · intro hx
    have hx' : x = generator h6Generator ^ 2 := hx
    subst x
    refine ⟨Finsupp.single h6Generator 2, ?_, ?_⟩
    · simp [monomialDegree, h6Generator_degree]
    · simp [← MvPolynomial.X_pow_eq_monomial, generator]

/-- There are at most two elements in the `(2,128)` component. Combined
with the independent nonvanishing certificate, there are exactly two. -/
theorem E2At_square_eq_zero_or (x : E2At 2 128) : x = 0 ∨ x = dataH6Sq := by
  have hx : (x : E2) ∈ Submodule.span F2 ({generator h6Generator ^ 2} : Set E2) :=
    (le_of_eq homogeneousPart_square_eq_span) x.property
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hx
  have h : ∀ a : F2, a = 0 ∨ a = 1 := by decide
  rcases h r with rfl | rfl
  · left
    apply Subtype.ext
    simpa using hr.symm
  · right
    apply Subtype.ext
    simpa [dataH6Sq] using hr.symm

end KIP126.LinE2
