module

public import KIP126.LinProgram.Model.ModulePresentation.Data

@[expose] public section


namespace KIP126.LinModule.Presentation
open KIP126.Core.Algebra

/-- Integer bidegree of a coefficient monomial in the original sphere algebra. -/
def coefficientDegree (m : LinE2.Generator →₀ ℕ) : ℤ × ℤ :=
  ((LinE2.monomialDegree m).1, (LinE2.monomialDegree m).2)

/-- The homogeneous span generated by all coefficient monomials and the
specified full generator family. Negative degrees are retained. -/
noncomputable def homogeneousSpan {M : Type*} [AddCommGroup M]
    [Module LinE2.E2 M] [Module F2 M] [IsScalarTower F2 LinE2.E2 M]
    {n : Nat} (g : Fin n → M) (degree : Fin n → ℤ × ℤ) (d : ℤ × ℤ) :
    Submodule F2 M :=
  Submodule.span F2 {x | ∃ (i : Fin n) (m : LinE2.Generator →₀ ℕ),
    coefficientDegree m + degree i = d ∧
      x = LinE2.projection (MvPolynomial.monomial m 1) • g i}

/-- Homogeneous parts of the unchanged complete quotient. This definition
asserts neither direct-sum independence nor comparison with actual Ext. -/
noncomputable def homogeneousPart (n : Nat) (relations : List String)
    (degree : Fin n → ℤ × ℤ) (d : ℤ × ℤ) : Submodule F2 (Model n relations) :=
  homogeneousSpan (generator n relations) degree d

end KIP126.LinModule.Presentation
