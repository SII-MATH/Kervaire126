+/-! ## May's TC3 smash-product lifting lemma
+
+The axioms for a closed symmetric tensor triangulated category state that
+smashing a distinguished triangle is exact.  The Generalized Mahowald Trick
+needs the stronger TC3 compatibility for *two* triangles: a compatible pair of
+classes in the middle of the resulting `3 × 3` diagram has a lift in the
+opposite corner.  This is the content of May's Lemma 4.6.
+
+It is deliberately a separate class.  It does not follow from the smaller
+`smashExact` field above without choosing and comparing a TC3 diagram.
+-/
+
+section MayTC3Smash
+
+variable (C : Type u) [Category.{v} C] [Preadditive C] [HasShift C ℤ]
+  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Limits.HasZeroObject C]
+  [MonoidalCategory C] [Pretriangulated C] [ClosedSymmetricTensorTriangulated C]
+
+/-- Boundary from `X ⊗ Z'` to `Σ(X ⊗ X')`, obtained from the connecting map
+of the second triangle.  The braiding makes the available suspension--smash
+isomorphism apply to the left factor. -/
+noncomputable def smashRightBoundary (T T' : Triangle C) :
+    T.obj₁ ⊗ T'.obj₃ ⟶ (shiftFunctor C (1 : ℤ)).obj (T.obj₁ ⊗ T'.obj₁) :=
+  (T.obj₁ ◁ T'.mor₃) ≫
+    (β_ T.obj₁ ((shiftFunctor C (1 : ℤ)).obj T'.obj₁)).hom ≫
+    (ClosedSymmetricTensorTriangulated.smashSuspIso T'.obj₁ T.obj₁).hom ≫
+    (shiftFunctor C (1 : ℤ)).map (β_ T'.obj₁ T.obj₁).hom
+
+/-- Boundary from `Z ⊗ X'` to `Σ(X ⊗ X')`, obtained from the connecting map
+of the first triangle. -/
+noncomputable def smashLeftBoundary (T T' : Triangle C) :
+    T.obj₃ ⊗ T'.obj₁ ⟶ (shiftFunctor C (1 : ℤ)).obj (T.obj₁ ⊗ T'.obj₁) :=
+  (T.mor₃ ▷ T'.obj₁) ≫
+    (ClosedSymmetricTensorTriangulated.smashSuspIso T.obj₁ T'.obj₁).hom
+
+/-- May's TC3 lifting property for smash products of distinguished triangles.
+
+For maps `a : W → X ⊗ Z'` and `b : W → Y ⊗ Y'` which agree in
+`Y ⊗ Z'`, it supplies `c : W → Z ⊗ X'`.  The first conclusion identifies
+`b` and `c` in `Z ⊗ Y'`; the second identifies their two boundary images in
+`Σ(X ⊗ X')`.  Taking `W` to be a sphere recovers exactly the homotopy-group
+form used in the Generalized Mahowald Trick. -/
+class HasMayTC3SmashLift where
+  lift : ∀ {T T' : Triangle C}, T ∈ distTriang C → T' ∈ distTriang C →
+    ∀ {W : C} (a : W ⟶ T.obj₁ ⊗ T'.obj₃) (b : W ⟶ T.obj₂ ⊗ T'.obj₂),
+      a ≫ (T.mor₁ ▷ T'.obj₃) = b ≫ (T.obj₂ ◁ T'.mor₂) →
+      ∃ c : W ⟶ T.obj₃ ⊗ T'.obj₁,
+        b ≫ (T.mor₂ ▷ T'.obj₂) = c ≫ (T.obj₃ ◁ T'.mor₁) ∧
+        a ≫ smashRightBoundary C T T' = c ≫ smashLeftBoundary C T T'
+
+/-- Eliminate the TC3 interface without exposing its implementation details. -/
+theorem mayTC3_smash_lift [HasMayTC3SmashLift C]
+    {T T' : Triangle C} (hT : T ∈ distTriang C) (hT' : T' ∈ distTriang C)
+    {W : C} (a : W ⟶ T.obj₁ ⊗ T'.obj₃) (b : W ⟶ T.obj₂ ⊗ T'.obj₂)
+    (hab : a ≫ (T.mor₁ ▷ T'.obj₃) = b ≫ (T.obj₂ ◁ T'.mor₂)) :
+    ∃ c : W ⟶ T.obj₃ ⊗ T'.obj₁,
+      b ≫ (T.mor₂ ▷ T'.obj₂) = c ≫ (T.obj₃ ◁ T'.mor₁) ∧
+      a ≫ smashRightBoundary C T T' = c ≫ smashLeftBoundary C T T' :=
+  HasMayTC3SmashLift.lift hT hT' a b hab
+
+end MayTC3Smash
+
 end KIPBase.StableHomotopy
