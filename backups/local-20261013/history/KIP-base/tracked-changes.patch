+/-! ### Maps between λ-power quotients -/
+
+/-- A map compatible with the `q`-th powers of `λ`.  The upper edge is kept
+explicit: the minimal synthetic interface has no theorem that constructs it
+for every map, because that construction requires the omitted coherence of
+weight shifts with `λ`. -/
+structure LambdaPowerSquare {X Y : Syn} (f : X ⟶ Y) (q : ℕ) where
+  shiftedMap : (SyntheticCategory.biShift (0, -(q : ℤ))).obj X ⟶
+    (SyntheticCategory.biShift (0, -(q : ℤ))).obj Y
+  comm : shiftedMap ≫ lambdaPow q Y = lambdaPow q X ≫ f
+
+/-- A λ-power-compatible map descends canonically to the corresponding
+cofibers. -/
+noncomputable def LambdaPowerSquare.modLambdaMap
+    {X Y : Syn} {f : X ⟶ Y} {q : ℕ} (sq : LambdaPowerSquare f q) :
+    XModLambdaN X q ⟶ XModLambdaN Y q :=
+  syn_functorial_cofiber.cofibMap (lambdaPow q X) (lambdaPow q Y)
+    sq.shiftedMap f sq.comm
+
+/-- The descended map agrees with `f` on the canonical cofiber inclusions. -/
+theorem LambdaPowerSquare.comp_modLambdaIncl
+    {X Y : Syn} {f : X ⟶ Y} {q : ℕ} (sq : LambdaPowerSquare f q) :
+    f ≫ syn_functorial_cofiber.cofibι (lambdaPow q Y) =
+      syn_functorial_cofiber.cofibι (lambdaPow q X) ≫ sq.modLambdaMap :=
+  syn_functorial_cofiber.cofibMap_ι (lambdaPow q X) (lambdaPow q Y)
+    sq.shiftedMap f sq.comm
+
+/-- The descended map has the prescribed effect on the connecting maps. -/
+theorem LambdaPowerSquare.modLambdaMap_comp_delta
+    {X Y : Syn} {f : X ⟶ Y} {q : ℕ} (sq : LambdaPowerSquare f q) :
+    sq.modLambdaMap ≫ syn_functorial_cofiber.cofibδ (lambdaPow q Y) =
+      syn_functorial_cofiber.cofibδ (lambdaPow q X) ≫
+        (shiftFunctor Syn (1 : ℤ)).map sq.shiftedMap :=
+  syn_functorial_cofiber.cofibMap_δ (lambdaPow q X) (lambdaPow q Y)
+    sq.shiftedMap f sq.comm
+
+/-! ### The λ-quotient tower
+
+For `n ≤ m`, the quotients `X/λ^m` and `X/λ^n` are related by the standard
+cofiber sequence
+```
+Σ^{0,-n}(X/λ^(m-n)) → X/λ^m → X/λ^n → Σ^{1,0}Σ^{0,-n}(X/λ^(m-n)).
+```
+The first two maps are forced by functorial cofibers once the factorization of
+λ-powers is made explicit.  The third map and the fact that this is a
+distinguished triangle are the octahedral/TC3 content, so they are packaged
+separately below rather than silently postulated by `HasFunctorialCofiber`.
+-/
+
+/-- Reassociate the source of `λ^(m-n)` on `Σ^{0,-n}X` with the source of
+`λ^m` on `X`. -/
+noncomputable def lambdaPowShiftIso (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    (SyntheticCategory.biShift (0, -((m - n : ℕ) : ℤ))).obj
+        ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X) ≅
+      (SyntheticCategory.biShift (0, -(m : ℤ))).obj X := by
+  let d : ℕ := m - n
+  exact
+    (SyntheticCategory.biShift_comp (Syn := Syn) (0, -(n : ℤ)) (0, -(d : ℤ))).app X ≪≫
+      eqToIso (by
+        congr 3
+        dsimp [d]
+        rw [← neg_add, ← Int.natCast_add, Nat.add_sub_of_le hnm])
+
+/-- The factor map `Σ^{0,-m}X → Σ^{0,-n}X` satisfying
+`factor ≫ λ^n = λ^m`. -/
+noncomputable def lambdaPowFactor (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    (SyntheticCategory.biShift (0, -(m : ℤ))).obj X ⟶
+      (SyntheticCategory.biShift (0, -(n : ℤ))).obj X :=
+  (lambdaPowShiftIso X n m hnm).inv ≫
+    lambdaPow (m - n) ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X)
+
+/-- Coherence of the weight shift with powers of `λ`.
+
+`biShift_comp` only supplies individual isomorphisms of functors.  It does
+not assert their associativity coherence, nor that `lam` is compatible with
+those isomorphisms.  Consequently this law cannot be derived from the bare
+`SyntheticCategory` fields.  It is a capability of a concrete synthetic model,
+not an unconditional theorem about every choice of shift isomorphisms. -/
+class HasLambdaPowerCoherence where
+  factor_comp : ∀ (X : Syn) (n m : ℕ) (hnm : n ≤ m),
+    lambdaPowFactor X n m hnm ≫ lambdaPow n X = lambdaPow m X
+
+/-- Compatibility of the factor map with λ-powers, exported from the
+coherence carried by the chosen synthetic model. -/
+theorem lambdaPowFactor_comp [coherence : HasLambdaPowerCoherence (Syn := Syn)]
+    (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    lambdaPowFactor X n m hnm ≫ lambdaPow n X = lambdaPow m X :=
+  coherence.factor_comp X n m hnm
+
+/-- The square comparing `λ^(m-n)` on `Σ^{0,-n}X` with `λ^m` on `X`. -/
+theorem lambdaPowShift_square [HasLambdaPowerCoherence (Syn := Syn)]
+    (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    (lambdaPowShiftIso X n m hnm).hom ≫ lambdaPow m X =
+      lambdaPow (m - n) ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X) ≫
+        lambdaPow n X := by
+  rw [← lambdaPowFactor_comp X n m hnm]
+  simp only [lambdaPowFactor, Category.assoc, Iso.hom_inv_id_assoc]
+
+/-- The quotient reduction `ρ_{n,m} : X/λ^m → X/λ^n`. -/
+noncomputable def lambdaRho [HasLambdaPowerCoherence (Syn := Syn)]
+    (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    XModLambdaN X m ⟶ XModLambdaN X n :=
+  syn_functorial_cofiber.cofibMap (lambdaPow m X) (lambdaPow n X)
+    (lambdaPowFactor X n m hnm) (𝟙 X) (by
+      simpa only [Category.comp_id] using lambdaPowFactor_comp X n m hnm)
+
+/-- The first map in the λ-quotient triangle:
+`Σ^{0,-n}(X/λ^(m-n)) → X/λ^m`. -/
+noncomputable def lambdaQuotientIncl [HasLambdaPowerCoherence (Syn := Syn)]
+    (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    XModLambdaN ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X) (m - n) ⟶
+      XModLambdaN X m :=
+  syn_functorial_cofiber.cofibMap
+    (lambdaPow (m - n) ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X))
+    (lambdaPow m X)
+    (lambdaPowShiftIso X n m hnm).hom
+    (lambdaPow n X)
+    (lambdaPowShift_square X n m hnm)
+
+/-- The octahedral data of the λ-quotient tower.  It is intentionally separate
+from `HasFunctorialCofiber`: choosing cofibers and maps of cofibers does not
+by itself provide the third edge of the octahedral triangle. -/
+class HasLambdaQuotientTower extends HasLambdaPowerCoherence (Syn := Syn) where
+  delta : ∀ (X : Syn) (n m : ℕ) (_hnm : n ≤ m),
+    XModLambdaN X n ⟶
+      (shiftFunctor Syn (1 : ℤ)).obj
+        (XModLambdaN ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X) (m - n))
+  distinguished : ∀ (X : Syn) (n m : ℕ) (hnm : n ≤ m),
+    Triangle.mk (lambdaQuotientIncl X n m hnm) (lambdaRho X n m hnm)
+      (delta X n m hnm) ∈ distTriang Syn
+  rho_comp : ∀ (X : Syn) (n m k : ℕ) (hnm : n ≤ m) (hmk : m ≤ k),
+    lambdaRho X m k hmk ≫ lambdaRho X n m hnm =
+      lambdaRho X n k (hnm.trans hmk)
+
+/-- The connecting map `δ_{n,m}` of the λ-quotient tower. -/
+noncomputable def lambdaDelta [HasLambdaQuotientTower (Syn := Syn)]
+    (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    XModLambdaN X n ⟶
+      (shiftFunctor Syn (1 : ℤ)).obj
+        (XModLambdaN ((SyntheticCategory.biShift (0, -(n : ℤ))).obj X) (m - n)) :=
+  HasLambdaQuotientTower.delta X n m hnm
+
+/-- The standard distinguished triangle relating `X/λ^m` and `X/λ^n`. -/
+theorem lambdaQuotient_triangle_distinguished [tower : HasLambdaQuotientTower (Syn := Syn)]
+    (X : Syn) (n m : ℕ) (hnm : n ≤ m) :
+    Triangle.mk (lambdaQuotientIncl X n m hnm) (lambdaRho X n m hnm)
+      (lambdaDelta X n m hnm) ∈ distTriang Syn :=
+  tower.distinguished X n m hnm
+
+/-- Functorial quotient reductions form an inverse system. -/
+theorem lambdaRho_comp [tower : HasLambdaQuotientTower (Syn := Syn)]
+    (X : Syn) (n m k : ℕ) (hnm : n ≤ m) (hmk : m ≤ k) :
+    lambdaRho X m k hmk ≫ lambdaRho X n m hnm =
+      lambdaRho X n k (hnm.trans hmk) :=
+  tower.rho_comp X n m k hnm hmk
+
