+/-- A relation in the concrete extension spectral sequence.  The ESS itself
+is indexed by `(filtration, complex-degree)`; `t` is the independent stem
+index of the converging input spectral sequences.  This belongs in the
+bounded-ESS layer so applications such as synthetic extensions need not
+import the higher commutativity development. -/
+def ESSRelationAt
+    {E₁ E₂ : SpectralSequence C ω} {ω' : Type w}
+    {A₁ A₂ : ω' → C} {F₁ : Filtration A₁} {F₂ : Filtration A₂}
+    {conv₁ : Convergence E₁ A₁ F₁} {conv₂ : Convergence E₂ A₂ F₂}
+    {cm : ConvergenceMorphism conv₁ conv₂}
+    {bnd₁ : F₁.IsBounded} {bnd₂ : F₂.IsBounded}
+    (ext : BoundedExtensionSS conv₁ conv₂ cm bnd₁ bnd₂)
+    (t : ω') (r s k : ℤ) {T : C}
+    (x : T ⟶ (ext.complex t).assocGraded s k)
+    (y : T ⟶ (ext.complex t).assocGraded (s + r) (k - 1)) : Prop :=
+  DifferentialRelation (ext.ess t) r ⟨s, k⟩ x y
+
+/-- Equality of two target representatives on the relevant ESS page.  The
+ambient representatives may differ; the correct assertion is that their
+difference factors through the page boundary. -/
+def ESSCongruentTargetsAt
+    {E₁ E₂ : SpectralSequence C ω} {ω' : Type w}
+    {A₁ A₂ : ω' → C} {F₁ : Filtration A₁} {F₂ : Filtration A₂}
+    {conv₁ : Convergence E₁ A₁ F₁} {conv₂ : Convergence E₂ A₂ F₂}
+    {cm : ConvergenceMorphism conv₁ conv₂}
+    {bnd₁ : F₁.IsBounded} {bnd₂ : F₂.IsBounded}
+    (ext : BoundedExtensionSS conv₁ conv₂ cm bnd₁ bnd₂)
+    (t : ω') (r s k : ℤ) {T : C}
+    (y₁ y₂ : T ⟶ (ext.complex t).assocGraded (s + r) (k - 1)) : Prop :=
+  Subobject.Factors
+    (((ext.ess t).ssData ⟨s + r, k - 1⟩).B
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ))
+    (by
+      change T ⟶ ((ext.ess t).ssData ⟨s + r, k - 1⟩).V
+      exact y₁ - y₂)
+
+/-- If two cycle representatives have equal images in a page quotient, their
+ambient representatives differ by that page's boundary. -/
+theorem boundary_factors_of_pageπ_eq
+    (D : SSData C) (n : WithTop ℕ) {T : C}
+    {y₁ y₂ : T ⟶ D.V}
+    (z₁ z₂ : T ⟶ Subobject.underlying.obj (D.Z n))
+    (hz₁ : z₁ ≫ (D.Z n).arrow = y₁)
+    (hz₂ : z₂ ≫ (D.Z n).arrow = y₂)
+    (hπ : z₁ ≫ D.pageπ n = z₂ ≫ D.pageπ n) :
+    Subobject.Factors (D.B n) (y₁ - y₂) := by
+  let i := Subobject.ofLE (D.B n) (D.Z n) (D.B_le_Z n)
+  have hzero : (z₁ - z₂) ≫ cokernel.π i = 0 := by
+    change (z₁ - z₂) ≫ D.pageπ n = 0
+    rw [Preadditive.sub_comp, hπ, sub_self]
+  let lift := Abelian.monoLift i (z₁ - z₂) hzero
+  rw [← Subobject.mk_arrow (D.B n), Subobject.mk_factors_iff]
+  refine ⟨lift, ?_⟩
+  change lift ≫ (D.B n).arrow = y₁ - y₂
+  calc
+    lift ≫ (D.B n).arrow = lift ≫ i ≫ (D.Z n).arrow := by
+      rw [Subobject.ofLE_arrow]
+    _ = (z₁ - z₂) ≫ (D.Z n).arrow := by
+      rw [← Abelian.monoLift_comp i (z₁ - z₂) hzero, Category.assoc]
+    _ = y₁ - y₂ := by rw [Preadditive.sub_comp, hz₁, hz₂]
+
+/-- Conversely, if the difference of two ambient representatives factors
+through the page boundary, their cycle lifts have the same page class. -/
+theorem pageπ_eq_of_boundary_factors
+    (D : SSData C) (n : WithTop ℕ) {T : C}
+    {y₁ y₂ : T ⟶ D.V}
+    (z₁ z₂ : T ⟶ Subobject.underlying.obj (D.Z n))
+    (hz₁ : z₁ ≫ (D.Z n).arrow = y₁)
+    (hz₂ : z₂ ≫ (D.Z n).arrow = y₂)
+    (hfac : Subobject.Factors (D.B n) (y₁ - y₂)) :
+    z₁ ≫ D.pageπ n = z₂ ≫ D.pageπ n := by
+  rw [← Subobject.mk_arrow (D.B n), Subobject.mk_factors_iff] at hfac
+  rcases hfac with ⟨u, hu⟩
+  change u ≫ (D.B n).arrow = y₁ - y₂ at hu
+  let i := Subobject.ofLE (D.B n) (D.Z n) (D.B_le_Z n)
+  have hdiff : z₁ - z₂ = u ≫ i := by
+    apply (cancel_mono (D.Z n).arrow).mp
+    rw [Preadditive.sub_comp, hz₁, hz₂]
+    have hi : i ≫ (D.Z n).arrow = (D.B n).arrow := by
+      dsimp [i]
+      exact Subobject.ofLE_arrow _
+    calc
+      y₁ - y₂ = u ≫ (D.B n).arrow := hu.symm
+      _ = u ≫ (i ≫ (D.Z n).arrow) := by rw [hi]
+      _ = (u ≫ i) ≫ (D.Z n).arrow := (Category.assoc _ _ _).symm
+  have hzero : (z₁ - z₂) ≫ D.pageπ n = 0 := by
+    rw [hdiff, Category.assoc]
+    change u ≫ i ≫ cokernel.π i = 0
+    rw [cokernel.condition, comp_zero]
+  rw [Preadditive.sub_comp, sub_eq_zero] at hzero
+  exact hzero
+
+/-- Equality in the page quotient is exactly ambient equality modulo its
+boundary, provided both representatives lift to page cycles. -/
+theorem pageπ_eq_iff_boundary_factors
+    (D : SSData C) (n : WithTop ℕ) {T : C}
+    {y₁ y₂ : T ⟶ D.V}
+    (z₁ z₂ : T ⟶ Subobject.underlying.obj (D.Z n))
+    (hz₁ : z₁ ≫ (D.Z n).arrow = y₁)
+    (hz₂ : z₂ ≫ (D.Z n).arrow = y₂) :
+    z₁ ≫ D.pageπ n = z₂ ≫ D.pageπ n ↔
+      Subobject.Factors (D.B n) (y₁ - y₂) := by
+  constructor
+  · exact boundary_factors_of_pageπ_eq D n z₁ z₂ hz₁ hz₂
+  · exact pageπ_eq_of_boundary_factors D n z₁ z₂ hz₁ hz₂
+
+/-- Two concrete ESS relations with the same ambient source have congruent
+target representatives on the relevant page. The page equality above and
+the boundary criterion prove the ambient difference factors through B. -/
+theorem ESSRelationAt.targets_congruent
+    {E₁ E₂ : SpectralSequence C ω} {ω' : Type w}
+    {A₁ A₂ : ω' → C} {F₁ : Filtration A₁} {F₂ : Filtration A₂}
+    {conv₁ : Convergence E₁ A₁ F₁} {conv₂ : Convergence E₂ A₂ F₂}
+    {cm : ConvergenceMorphism conv₁ conv₂}
+    {bnd₁ : F₁.IsBounded} {bnd₂ : F₂.IsBounded}
+    {ext : BoundedExtensionSS conv₁ conv₂ cm bnd₁ bnd₂}
+    {t : ω'} {r s k : ℤ} {T : C}
+    {x : T ⟶ (ext.complex t).assocGraded s k}
+    {y₁ y₂ : T ⟶ (ext.complex t).assocGraded (s + r) (k - 1)}
+    (h₁ : ESSRelationAt ext t r s k x y₁)
+    (h₂ : ESSRelationAt ext t r s k x y₂) :
+    ESSCongruentTargetsAt ext t r s k y₁ y₂ := by
+  unfold ESSRelationAt DifferentialRelation at h₁ h₂
+  dsimp only at h₁ h₂
+  rcases h₁ with ⟨xZ₁, hxZ₁, yZ₁, hyZ₁, hrel₁⟩
+  rcases h₂ with ⟨xZ₂, hxZ₂, yZ₂, hyZ₂, hrel₂⟩
+  have hxZ : xZ₁ = xZ₂ := by
+    apply (cancel_mono
+      (((ext.ess t).ssData ⟨s, k⟩).Z
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ)).arrow).mp
+    rw [hxZ₁, hxZ₂]
+  have hπ : yZ₁ ≫
+      ((ext.ess t).ssData (⟨s, k⟩ + (ext.ess t).diffDeg r)).pageπ
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) =
+      yZ₂ ≫ ((ext.ess t).ssData (⟨s, k⟩ + (ext.ess t).diffDeg r)).pageπ
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) := by
+    rw [← hrel₁, ← hrel₂, hxZ]
+  have hdeg : (⟨s, k⟩ + (ext.ess t).diffDeg r : ℤ × ℤ) =
+      ⟨s + r, k - 1⟩ := by rfl
+  unfold ESSCongruentTargetsAt
+  simpa only [hdeg] using boundary_factors_of_pageπ_eq
+    ((ext.ess t).ssData (⟨s, k⟩ + (ext.ess t).diffDeg r))
+    (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) yZ₁ yZ₂ hyZ₁ hyZ₂ hπ
+
+/-- Congruence of two source representatives modulo the boundary on the
+source page. -/
+def ESSCongruentSourcesAt
+    {E₁ E₂ : SpectralSequence C ω} {ω' : Type w}
+    {A₁ A₂ : ω' → C} {F₁ : Filtration A₁} {F₂ : Filtration A₂}
+    {conv₁ : Convergence E₁ A₁ F₁} {conv₂ : Convergence E₂ A₂ F₂}
+    {cm : ConvergenceMorphism conv₁ conv₂}
+    {bnd₁ : F₁.IsBounded} {bnd₂ : F₂.IsBounded}
+    (ext : BoundedExtensionSS conv₁ conv₂ cm bnd₁ bnd₂)
+    (t : ω') (r s k : ℤ) {T : C}
+    (x₁ x₂ : T ⟶ (ext.complex t).assocGraded s k) : Prop :=
+  Subobject.Factors
+    (((ext.ess t).ssData ⟨s, k⟩).B
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ))
+    (by
+      change T ⟶ ((ext.ess t).ssData ⟨s, k⟩).V
+      exact x₁ - x₂)
+
+/-- Differential relations preserve source congruence: sources equal modulo
+the source-page boundary have targets equal modulo the target-page boundary. -/
+theorem ESSRelationAt.targets_congruent_of_sources_congruent
+    {E₁ E₂ : SpectralSequence C ω} {ω' : Type w}
+    {A₁ A₂ : ω' → C} {F₁ : Filtration A₁} {F₂ : Filtration A₂}
+    {conv₁ : Convergence E₁ A₁ F₁} {conv₂ : Convergence E₂ A₂ F₂}
+    {cm : ConvergenceMorphism conv₁ conv₂}
+    {bnd₁ : F₁.IsBounded} {bnd₂ : F₂.IsBounded}
+    {ext : BoundedExtensionSS conv₁ conv₂ cm bnd₁ bnd₂}
+    {t : ω'} {r s k : ℤ} {T : C}
+    {x₁ x₂ : T ⟶ (ext.complex t).assocGraded s k}
+    {y₁ y₂ : T ⟶ (ext.complex t).assocGraded (s + r) (k - 1)}
+    (h₁ : ESSRelationAt ext t r s k x₁ y₁)
+    (h₂ : ESSRelationAt ext t r s k x₂ y₂)
+    (hx : ESSCongruentSourcesAt ext t r s k x₁ x₂) :
+    ESSCongruentTargetsAt ext t r s k y₁ y₂ := by
+  unfold ESSRelationAt DifferentialRelation at h₁ h₂
+  dsimp only at h₁ h₂
+  rcases h₁ with ⟨xZ₁, hxZ₁, yZ₁, hyZ₁, hrel₁⟩
+  rcases h₂ with ⟨xZ₂, hxZ₂, yZ₂, hyZ₂, hrel₂⟩
+  unfold ESSCongruentSourcesAt at hx
+  rw [← Subobject.mk_arrow
+    (((ext.ess t).ssData ⟨s, k⟩).B
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ)),
+    Subobject.mk_factors_iff] at hx
+  rcases hx with ⟨u, hu⟩
+  change u ≫ (((ext.ess t).ssData ⟨s, k⟩).B
+    (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ)).arrow = x₁ - x₂ at hu
+  let i := Subobject.ofLE
+    (((ext.ess t).ssData ⟨s, k⟩).B
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ))
+    (((ext.ess t).ssData ⟨s, k⟩).Z
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ))
+    (((ext.ess t).ssData ⟨s, k⟩).B_le_Z
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ))
+  have hxZ : xZ₁ - xZ₂ = u ≫ i := by
+    apply (cancel_mono
+      (((ext.ess t).ssData ⟨s, k⟩).Z
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ)).arrow).mp
+    rw [Preadditive.sub_comp, hxZ₁, hxZ₂]
+    dsimp [i]
+    rw [Category.assoc, Subobject.ofLE_arrow]
+    exact hu.symm
+  have hsrcπ : xZ₁ ≫ ((ext.ess t).ssData ⟨s, k⟩).pageπ
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) =
+    xZ₂ ≫ ((ext.ess t).ssData ⟨s, k⟩).pageπ
+      (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) := by
+    have hzero : (xZ₁ - xZ₂) ≫ ((ext.ess t).ssData ⟨s, k⟩).pageπ
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) = 0 := by
+      rw [hxZ, Category.assoc]
+      change u ≫ i ≫ cokernel.π i = 0
+      rw [cokernel.condition, comp_zero]
+    rw [Preadditive.sub_comp, sub_eq_zero] at hzero
+    exact hzero
+  have hπ : yZ₁ ≫
+      ((ext.ess t).ssData (⟨s, k⟩ + (ext.ess t).diffDeg r)).pageπ
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) =
+      yZ₂ ≫ ((ext.ess t).ssData (⟨s, k⟩ + (ext.ess t).diffDeg r)).pageπ
+        (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) := by
+    calc
+      _ = xZ₁ ≫ ((ext.ess t).ssData ⟨s, k⟩).pageπ
+          (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) ≫ (ext.ess t).d r ⟨s, k⟩ :=
+        hrel₁.symm
+      _ = xZ₂ ≫ ((ext.ess t).ssData ⟨s, k⟩).pageπ
+          (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) ≫ (ext.ess t).d r ⟨s, k⟩ := by
+        simpa only [Category.assoc] using
+          congrArg (fun q => q ≫ (ext.ess t).d r ⟨s, k⟩) hsrcπ
+      _ = _ := hrel₂
+  have hdeg : (⟨s, k⟩ + (ext.ess t).diffDeg r : ℤ × ℤ) =
+      ⟨s + r, k - 1⟩ := by rfl
+  unfold ESSCongruentTargetsAt
+  simpa only [hdeg] using boundary_factors_of_pageπ_eq
+    ((ext.ess t).ssData (⟨s, k⟩ + (ext.ess t).diffDeg r))
+    (↑(r - (ext.ess t).r₀).toNat : WithTop ℕ) yZ₁ yZ₂ hyZ₁ hyZ₂ hπ
+
