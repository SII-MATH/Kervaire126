+          (0, ((0 - eHat 𝒮 T.f) - eHat 𝒮 T.g) - eHat 𝒮 T.h)).app
+            ((nu 𝒮 Syn).obj T.X) ≪≫
+        eqToIso (congrArg
+          (fun p => (SyntheticCategory.biShift (Syn := Syn) p).obj ((nu 𝒮 Syn).obj T.X))
+          hweight) ≪≫
+        (SyntheticCategory.biShift_compat (Syn := Syn) 1).app ((nu 𝒮 Syn).obj T.X) ≪≫
+        (shiftFunctor Syn (1 : ℤ)).mapIso
+          ((SyntheticCategory.biShift_zero (Syn := Syn)).symm.app ((nu 𝒮 Syn).obj T.X))
+
+/-- KIP §3.20 in the exact form used by the Generalized Mahowald Trick.
+    Unlike the older `fhat_triangle`, the three morphisms are not arbitrary
+    witnesses: they are the canonical shifted maps constructed from `fHat`.
+    This is the interface needed to smash this triangle with a λ-quotient
+    triangle in the Mahowald argument. -/
+axiom canonical_hatted_triangle (T : StableHomotopy.HoCofiberSequence (𝒮 := 𝒮))
+    (hsum : eHat 𝒮 T.f + eHat 𝒮 T.g + eHat 𝒮 T.h = 1) :
+    Triangle.mk
+      (hattedMap 𝒮 Syn T.f 0)
+      (hattedMap 𝒮 Syn T.g (0 - eHat 𝒮 T.f))
+      (hattedMap 𝒮 Syn T.h ((0 - eHat 𝒮 T.f) - eHat 𝒮 T.g) ≫
+        (hattedTargetIso 𝒮 Syn T hsum).hom) ∈ distTriang Syn
 
 /-! ### Distinguished triangles in synthetic spectra -/
 
