+namespace GeneralizedMahowaldData
+
+/-- `r=n+m+l`. -/
+abbrev r (D : GeneralizedMahowaldData) : ℤ :=
+  D.nIndex + D.mIndex + D.lIndex
+
+/-- `n₁=n-e(f)`. -/
