+    (∀ r ∈ basisRows, r.s=15 → r.t=139 → r.index=1 → r.monomial="3,2,287,1") ∧
+    (∀ r ∈ basisRows, r.s=15 → r.t=139 → r.index=3 → r.monomial="0,1,439,1") := by
