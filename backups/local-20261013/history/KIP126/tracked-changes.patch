+  have zero_of_infinity_zero (z' : (Subobject.underlying.obj (P.Z ⊤) : ModuleCat ℤ))
+      (hzero : P.pageπ ⊤ z'=0) :
+      PageRepresentatives.cycleMap H SphereSpectrum ⊤ (s,t) z' ∈
