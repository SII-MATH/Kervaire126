+    {x : (F.obj X).E₂ i} {a b : BiHom (i.2.1-i.1) i.2.2 X}
+    (ha : Detects c i x a) (hb : FiltrationAtLeast unit (i.1+1) (b-a)) :
+    Detects c i x b := by
