+private theorem alpha_exists_from_finite_frames_finite_sphere_detected_rho {D : Model H M Syn}
+    (BHS : EInftyInput D) (i j : ℕ) (hi : 0 < i) (hj : 0 < j) (hij : i ≤ j) (s t : ℤ)
+    (x : E2 H SphereSpectrum s t)
