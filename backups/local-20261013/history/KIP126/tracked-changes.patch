+  have hyq := (BHS.labels.1 .sphere 11 (by decide) (10,134) 3 (by decide) yy _).mp hf'
+  have hz : NestedQuotient.projection _ (PageRepresentatives.boundaries H SphereSpectrum 4 (10,134)) (xx-yy)=0 :=
