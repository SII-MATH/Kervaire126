+  have hd := alpha_exists_from_finite_frames_detected_map (D:=D) (.quotient j .sphere) (.quotient i .sphere) rho (s,t,t-0) _ a ha.1
+  have hd' : Detects (D.quotientConvergence i hi) (s,t,t-0)
